# ===========================================
# SAM3 Video Segmentation - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Application
DEBUG=false

# Supabase (Required)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# Modal (Required for GPU worker)
# Get these from https://modal.com/settings
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret

# API Configuration
# Set this to your public API URL in production
API_BASE_URL=http://localhost:8000

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage Buckets (must match Supabase bucket names)
UPLOAD_BUCKET=uploads
OUTPUT_BUCKET=outputs

# Video Limits
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=60
